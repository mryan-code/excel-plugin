{
  "name": "excel-plugin",
  "version": "0.1.0",
  "description": "A simple Excel task-pane add-in (TypeScript + Office JS API) \u2014 built as a learning project.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {},
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.5",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-manifest": "^1.13.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "@types/office-js": "^1.0.400"
  }
}
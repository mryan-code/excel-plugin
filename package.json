{
  "name": "excel-plugin",
  "version": "0.1.0",
  "description": "A simple Excel task-pane add-in (TypeScript + Office JS API) — built as a learning project.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev-server": "webpack serve --mode development",
    "sideload": "mkdir -p \"/Users/inkt/Library/Containers/com.microsoft.Excel/Data/Documents/wef\" && cp manifest.xml \"/Users/inkt/Library/Containers/com.microsoft.Excel/Data/Documents/wef/\"",
    "start": "npm run sideload && npm run dev-server",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.614",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  }
}

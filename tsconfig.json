{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "lib": ["es2015", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "outDir": "dist",
    "sourceMap": true,
    "target": "es2015",
    "types": ["office-js"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*"]
}
